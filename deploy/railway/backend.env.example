# Cole estas variáveis no serviço steelcontrol-web do Railway.
# Nunca coloque os valores reais deste arquivo no Git.

NODE_ENV=production
SECURITY_PROFILE=level9
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

JWT_SECRET=COLE_UM_HEX_ALEATORIO_DE_128_CARACTERES
JWT_EXPIRES_IN=30m
SESSION_COOKIE_MAX_AGE_MS=1800000
ENFORCE_HTTPS=true
ADMIN_MFA_REQUIRED=true
SENSITIVE_DATA_KEY=COLE_UMA_CHAVE_BASE64_DE_32_BYTES
MONITORING_TOKEN=COLE_UM_HEX_ALEATORIO_DE_96_CARACTERES

FACE_API_URL=http://${{steelcontrol-face.RAILWAY_PRIVATE_DOMAIN}}:${{steelcontrol-face.PORT}}
FACE_API_KEY=COLE_A_MESMA_CHAVE_CONFIGURADA_NO_STEELCONTROL_FACE
FACE_API_TIMEOUT_MS=90000

BREVO_API_KEY=COLE_A_CHAVE_DA_API_BREVO
BREVO_FROM_EMAIL=remetente-verificado@empresa.com
BREVO_FROM_NAME=SteelControl
BREVO_TIMEOUT_MS=15000

# Alternativa SMTP para outro provedor. No Railway, prefira a API HTTPS acima.
# EMAIL_USER=seu-email@gmail.com
# EMAIL_APP_PASSWORD=COLE_A_SENHA_DE_APP_DO_GOOGLE
# EMAIL_FROM=SteelControl <seu-email@gmail.com>

DISCOVERY_ENABLED=false
DEVICE_COMMAND_LEASE_MS=15000

# Bootstrap seguro do primeiro administrador. Depois do primeiro acesso,
# você pode apagar estas seis variáveis do Railway.
SEED_ADMIN_EMAIL=seu-admin@empresa.com
SEED_ADMIN_PASSWORD=COLE_UMA_SENHA_FORTE_E_UNICA
SEED_ADMIN_NAME=Administrador
SEED_COMPANY_NAME=Nome da empresa
SEED_COMPANY_CNPJ=00.000.000/0000-00

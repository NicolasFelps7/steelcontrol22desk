{
  "name": "steelcontrol-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "SteelControl Desktop com Edge integrado",
  "author": "SteelControl",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.steelcontrol.desktop",
    "productName": "SteelControl",
    "artifactName": "SteelControl-Instalador-${version}.${ext}",
    "directories": {"output": "release"},
    "files": ["*.cjs", "ui/**/*", "assets/**/*"],
    "extraResources": [{"from": "edge-dist/SteelControlEdge", "to": "edge", "filter": ["**/*"]}],
    "win": {"target": "nsis", "icon": "assets/steelcontrol.ico"},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}

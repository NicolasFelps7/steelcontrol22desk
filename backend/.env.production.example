# SteelControl — exemplo seguro para produção
# Copie apenas os nomes necessários para o secret manager do provedor.
# Nunca grave valores reais neste arquivo ou no Git.

NODE_ENV=production
SECURITY_PROFILE=level9
PORT=3000

DATABASE_URL="postgresql://usuario:senha@host:5432/steelcontrol?schema=public"
REDIS_URL="redis://usuario:senha@host:6379/0"

JWT_SECRET="COLE_UMA_CHAVE_ALEATORIA_COM_64_OU_MAIS_CARACTERES"
JWT_EXPIRES_IN="30m"
SESSION_COOKIE_MAX_AGE_MS=1800000
ENFORCE_HTTPS=true
ADMIN_MFA_REQUIRED=true
SENSITIVE_DATA_KEY="COLE_32_BYTES_EM_BASE64_OU_64_CARACTERES_HEXADECIMAIS"
MONITORING_TOKEN="COLE_UMA_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES"

FACE_API_URL="https://face-api.seu-dominio.com"
FACE_API_KEY="COLE_UMA_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES"
FACE_API_TIMEOUT_MS=90000

# Recomendado para hospedagem em nuvem: API transacional por HTTPS.
BREVO_API_KEY="COLE_A_CHAVE_DA_API_BREVO"
BREVO_FROM_EMAIL="remetente-verificado@empresa.com"
BREVO_FROM_NAME="SteelControl"
BREVO_TIMEOUT_MS=15000

# Alternativa SMTP. Não configure junto se não for utilizar.
# EMAIL_USER="seu-email@gmail.com"
# EMAIL_APP_PASSWORD="senha-de-app-do-google"
# EMAIL_FROM="SteelControl <seu-email@gmail.com>"

CORS_ORIGINS="https://steelcontrol.seu-dominio.com"
DEVICE_COMMAND_LEASE_MS=15000
DISCOVERY_ENABLED=false

# Autenticação: login sempre exige segundo fator, inclusive facial.
# ADMIN_MFA_REQUIRED=false não desativa essa proteção.

